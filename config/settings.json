    "agentOverrides": {
      "astra-code-reviewer": {
        "model": "codex-auto/gpt-6-astra",
        "thinking": "xhigh"
      },
      "reviewer": {
        "model": "codex-auto/gpt-6-astra"
      },
      "oracle": {
        "model": "codex-auto/gpt-6-astra"
      },
      "worker": {
        "model": "antigravity/gemini-3.8-flash"
      },
      "literature-coordinator": {
        "model": "codex-auto/gpt-6-astra",
        "thinking": "xhigh"
      },
      "literature-leaf": {
        "model": "codex-auto/gpt-6.1-sol",
        "thinking": "medium"
      },
      "literature-reviewer": {
        "model": "codex-auto/gpt-6-astra",
        "thinking": "xhigh"
      }
    }
  },
  "lastChangelogVersion": "1.3.0"
}
