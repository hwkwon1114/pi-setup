{
  "theme": "light",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "high",
  "warnings": {
    "anthropicExtraUsage": false
  },
  "extensions": [],
  "packages": [
    "npm:pi-subagents@0.85.0",
    "npm:pi-antigravity@0.11.0",
    "./packages/research-runtime",
    "npm:@juicesharp/rpiv-ask-user-question@2.15.0",
    "git:github.com/picassio/pi-cc-patch@fe58871de6317e1ac24bb33617db73b0cff66a5e",
    "./packages/lab"
  ],
  "enabledModels": [
    "antigravity/gemini-3.8-flash",
    "antigravity/gemini-4-argon",
    "codex-auto/gpt-6-astra",
    "codex-auto/gpt-6.1-sol",
    "anthropic/claude-opus-5-5",
    "anthropic/claude-sonnet-5-5",
    "codex-auto/gpt-6.1-terra"
  ],
  "subagents": {
    "defaultModel": "codex-auto/gpt-6.1-sol",
    "defaultSubagentOnlyExtensions": [
      "~/.pi/agent/extensions/multi-codex/index.ts"
    ],
    "agentOverrides": {
      "council-astra": {
        "model": "codex-auto/gpt-6-astra",
        "thinking": "max"
      },
      "council-claude": {
        "model": "anthropic/claude-opus-5-5",
        "thinking": "max"
      },
      "council-argon": {
        "model": "antigravity/gemini-4-argon",
        "thinking": "max"
      },
      "reviewer": {
        "model": "codex-auto/gpt-6-astra",
        "thinking": "max"
      },
      "worker": {
        "model": "codex-auto/gpt-6.1-terra",
        "thinking": "xhigh"
      },
      "literature-coordinator": {
        "model": "codex-auto/gpt-6-astra",
        "thinking": "xhigh"
      },
      "literature-leaf": {
        "model": "codex-auto/gpt-6.1-sol",
        "thinking": "medium"
      },
      "literature-reviewer": {
        "model": "codex-auto/gpt-6-astra",
        "thinking": "xhigh"
      },
      "verifier": {
        "model": "codex-auto/gpt-6-astra",
        "thinking": "max"
      },
      "critic": {
        "model": "antigravity/gemini-4-argon",
        "thinking": "max"
      }
    }
  },
  "collapseChangelog": true
}
